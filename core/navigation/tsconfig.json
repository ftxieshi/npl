{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "preserve", "jsxImportSource": "solid-js", "strict": true,
    "skipLibCheck": true, "noEmit": false, "esModuleInterop": true,
    "isolatedModules": true, "declaration": true, "declarationMap": true,
    "sourceMap": true, "emitDeclarationOnly": true, "outDir": "dist"
  },
  "include": ["src/**/*"], "exclude": ["node_modules", "dist"]
}
